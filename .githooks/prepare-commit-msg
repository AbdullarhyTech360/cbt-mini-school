#!/usr/bin/env bash
# prepare-commit-msg hook — enforces Conventional Commits.
# Installed via `core.hooksPath`. Allows merge/cherry-pick/amend messages.
#
# This file lives at the repo root inside `.githooks/` so it is versioned.
# Symlinked/copied into the active hooks dir by `scripts/install_git_hooks.sh`.

MSG_FILE="$1"
SOURCE="$2"

# Allow messages generated by git itself (merge/squash).
if [[ "$SOURCE" == "merge" || "$SOURCE" == "squash" ]]; then
  exit 0
fi

# First non-comment, non-empty line of the message.
FIRST_LINE=$(grep -v '^#' "$MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1)

# Nothing typed yet (e.g. empty commit) — let git handle it.
if [[ -z "$FIRST_LINE" ]]; then
  exit 0
fi

CONVENTIONAL_RE='^(feat|fix|refactor|chore|style|docs|test|perf|build|ci|revert)(\([a-z0-9._/-]+\))?: .+'

if ! [[ "$FIRST_LINE" =~ $CONVENTIONAL_RE ]]; then
  echo
  echo "ERROR: commit message must follow Conventional Commits" >&2
  echo "  Format:  type(scope): subject" >&2
  echo "  Example: feat(auth): add password reset flow" >&2
  echo "  Types:   feat | fix | refactor | chore | style | docs | test | perf | build | ci | revert" >&2
  echo
  exit 1
fi

exit 0
